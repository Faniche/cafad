# Physical cores; 56 * 80% -> floor(44.8) -> 44 data-processing workers.
nproc=56
data_proc_usage=80%

# 本机离线绘图可使用的 CPU 进程上限；绘图只在可避免重复读取 CSV 时并行。
local_cpu_available_cpu=10

# 注入资格的最低轨迹点数。40 = 最长 30 点事件 + 前后各 5 个正常上下文点。
# 点数不足的航班保留在其 split 中，但不参与异常注入并作为正常轨迹输出。
injection_minimum_trajectory_points=40

# 仅在运行公开 Web 控制台时，于实际 .env 设置高强度随机令牌；不得提交真实值。
# web_console_token=
# Web 控制台唯一监听端口；实际 .env 必填。
web_console_port=8765
